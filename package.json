    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "highlight.js": "11.12.0",
    "htmlparser2": "12.0.0",
    "marked": "18.0.12",
    "sanitize-html": "2.17.7"
  },
  "optionalDependencies": {
    "playwright": "^1.58.2"
  },

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check && node scripts/build-vercel.cjs",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{views,public,lib,bin}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "hnd1"
  ]
}

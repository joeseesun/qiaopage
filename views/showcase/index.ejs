<%- include('head', {title:'QiaoPage · 让想法成为作品',description:'用 Vibe coding 做的小工具、小游戏和交互实验。浏览作品，直接体验；用一条命令发布你的 HTML。',canonical:baseUrl+'/explore'}) %>
<%- include('nav') %>
<main id="main" class="wrap"><header class="intro"><div><p class="eyebrow"><span class="live-dot"></span> 一个持续生长的创作空间</p><h1>一些想法，<br>已经可以玩了<span class="title-dot">。</span></h1><p class="lede">小工具、小游戏、交互实验。<br class="mobile-only">打开一个，亲手试试。</p></div><div class="collection-mark" aria-label="共 <%= total %> 件作品"><span class="collection-number"><%= String(total).padStart(2,'0') %></span><span>件作品 · 不断更新</span><svg width="130" height="45" viewBox="0 0 130 45" aria-hidden="true"><path d="M3 27c18-23 24 23 44 0S78 9 87 23s20 8 37-9m-12 0h13v13" fill="none" stroke="currentColor" stroke-width="2"/></svg></div></header>
<section class="collection" aria-labelledby="collection-heading"><div class="collection-tools"><h2 id="collection-heading">作品集 <span class="count"><%= total %></span></h2><form class="search" role="search" action="/explore"><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m15 15 5 5" stroke="currentColor" stroke-width="1.7"/></svg><label class="sr-only" for="q">搜索作品</label><input id="q" name="q" value="<%= q %>" placeholder="寻找一个有趣的作品…" maxlength="200"><% if(tag){ %><input type="hidden" name="tag" value="<%= tag %>"><% } %><button type="submit">搜索</button></form></div>
<div class="filters" aria-label="作品分类"><a href="/explore?q=<%= encodeURIComponent(q) %>" <%- !tag?'aria-current="true"':'' %>>全部作品</a><% for(const item of tags){ %><a href="/explore?tag=<%= encodeURIComponent(item) %>&q=<%= encodeURIComponent(q) %>" <%- tag===item?'aria-current="true"':'' %>><%= item %></a><% } %></div>
<% if(q || tag){ %><p class="filter-summary"><%= q ? '“'+q+'”' : tag %> · 找到 <%= filteredCount %> 件作品 <a href="/explore">清除筛选</a></p><% } %>
<% if(!works.length){ %><div class="empty"><svg width="60" height="60" viewBox="0 0 60 60" aria-hidden="true"><rect x="10" y="12" width="40" height="37" rx="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 30h20m-10-10v20" stroke="currentColor" stroke-width="2"/></svg><h3><%= total?'暂时没有匹配的作品':'第一件作品，从这里开始。' %></h3><p><%= total?'换个关键词，或浏览所有作品。':'把一个 HTML 文件发布成一个可以访问的链接。' %></p><a class="button" href="<%= total?'/explore':'/publish' %>"><%= total?'浏览所有作品':'查看发布方法' %></a></div><% }else{ %>
<div class="works"><% works.forEach((work,index)=>{ const motif=[...work.slug].reduce((s,c)=>s+c.charCodeAt(0),0)%4; %><article class="work-card"><a href="/s/<%= work.slug %>/" class="cover theme-<%= work.theme %>" aria-label="体验 <%= work.title %>"><% if(work.cover_mime){ %><img src="/cover/<%= work.slug %>?v=<%= work.revision %>" alt="<%= work.title %>的作品画面" width="1280" height="800" loading="<%= index<3?'eager':'lazy' %>"><% }else{ %><svg class="generated-cover motif-<%= motif %>" viewBox="0 0 480 300" role="img" aria-label="<%= work.title %>的图形封面"><% if(motif===0){ %><circle cx="240" cy="150" r="85" class="cover-fill"/><circle cx="240" cy="150" r="58" class="cover-cut"/><path d="M240 65v85l58 45" fill="none" class="cover-line" stroke-width="9"/><% }else if(motif===1){ %><path d="M80 165q40-150 80 0t80 0t80 0t80 0" fill="none" class="cover-line" stroke-width="18"/><path d="M80 200h320" class="cover-line" stroke-width="2"/><% }else if(motif===2){ %><rect x="120" y="62" width="145" height="145" rx="25" class="cover-fill"/><circle cx="285" cy="169" r="68" class="cover-cut"/><circle cx="285" cy="169" r="42" class="cover-fill"/><% }else{ %><path d="M140 73h75v75h-75zM233 73h75v75h-75zM140 166h75v75h-75z" class="cover-fill"/><circle cx="270" cy="204" r="38" class="cover-fill"/><% } %></svg><span class="cover-caption"><%= work.tags[0] || 'HTML 实验' %></span><% } %><span class="cover-launch" aria-hidden="true">打开体验 ↗</span></a><div class="work-info"><div class="work-title"><h3><a href="/s/<%= work.slug %>/"><%= work.title %></a></h3><span aria-hidden="true">↗</span></div><p><%= work.description || '一个可以在浏览器中直接体验的 HTML 作品。' %></p><div class="work-meta"><div><% work.tags.slice(0,3).forEach(t=>{ %><a href="/explore?tag=<%= encodeURIComponent(t) %>"><%= t %></a><% }) %></div><time datetime="<%= work.updated_at %>"><%= formatDate(work.updated_at) %></time></div></div></article><% }) %></div>
<% if(pages>1){ %><nav class="pagination" aria-label="分页"><% if(page>1){ %><a href="/explore?q=<%= encodeURIComponent(q) %>&tag=<%= encodeURIComponent(tag) %>&page=<%= page-1 %>">← 上一页</a><% } %><span><%= page %> / <%= pages %></span><% if(page<pages){ %><a href="/explore?q=<%= encodeURIComponent(q) %>&tag=<%= encodeURIComponent(tag) %>&page=<%= page+1 %>">下一页 →</a><% } %></nav><% } %><% } %></section></main>
<footer class="footer wrap"><span>QiaoPage · 把灵感留成作品</span><a href="/publish">从一个 HTML 开始 ↗</a></footer><div class="toast" role="status"></div></body></html>

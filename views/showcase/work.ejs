<%- include('head',{title:work.title+' · Quickshare',description:work.description || '在浏览器中体验这个 HTML 作品。',canonical:work.url}) %>
<%- include('nav') %><main id="main" class="viewer wrap"><div class="viewer-header"><div><a class="back-link" href="/explore">← 所有作品</a><h1><%= work.title %></h1><% if(work.description){ %><p><%= work.description %></p><% } %></div><div class="viewer-actions"><button class="button secondary" data-copy="<%= work.url %>">复制链接</button><a class="button secondary" href="/download/<%= work.slug %>"><%= work.file_count>1?'下载首页 HTML':'下载 HTML' %></a><button class="button" id="fullscreen">全屏体验 <span aria-hidden="true">↗</span></button></div></div><div class="stage" id="stage"><iframe id="work-frame" src="<%= work.embedUrl %>" title="<%= work.title %>" sandbox="allow-scripts allow-forms allow-modals allow-downloads" allow="fullscreen" allowfullscreen></iframe></div><p class="viewer-note"><%= work.file_count>1?'这是一个多文件网站，下载首页后仍需其它资源才能完整运行。':'作品在独立沙箱中运行。需要本地存储的作品，可下载 HTML 后打开。' %></p></main><div class="toast" role="status"></div></body></html>

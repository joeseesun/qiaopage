HOST=127.0.0.1
PORT=3000
BASE_URL=http://127.0.0.1:3000
# Generate a random value with npm run setup; never commit actual secrets.
QUICKSHARE_TOKEN=
DB_PATH=.data/quickshare.sqlite

# Default: local SQLite plus private files next to DB_PATH.
OBJECT_STORE=filesystem
# OBJECTS_PATH=.data/objects
# Optional libSQL HTTP database; secrets must stay in the environment.
# DATABASE_URL=libsql://your-database.example
# DATABASE_AUTH_TOKEN=
# Optional private S3-compatible bucket (including Cloudflare R2).
# OBJECT_STORE=s3
# S3_ENDPOINT=https://your-storage-endpoint.example
# S3_BUCKET=quickshare
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PREFIX=quickshare/objects/
# S3_FORCE_PATH_STYLE=false

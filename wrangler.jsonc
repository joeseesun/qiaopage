{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quickshare-agent",
  "main": ".cloudflare-build/worker/worker.mjs",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "node scripts/build-cloudflare.cjs"
  },
  "assets": {
    "directory": ".cloudflare-build/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "Quickshare"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Quickshare"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "quickshare-agent-objects"
    }
  ],
  "observability": {
    "enabled": false
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "secrets": {
    "required": [
      "QUICKSHARE_TOKEN"
    ]
  }
}
